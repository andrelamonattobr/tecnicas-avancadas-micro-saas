{
  "post-edit-linter": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks-props/scripts/auto-lint.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}